---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <section class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" aria-labelledby="filters-heading" data-testid="game-filters">
            <div class="flex flex-col gap-4">
              <div>
                <h3 id="filters-heading" class="text-lg font-semibold text-slate-100">Filter games</h3>
                <p class="text-sm text-slate-400">Choose one or more categories and a publisher.</p>
              </div>

              <fieldset>
                <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        value={category.id}
                        data-testid={`category-filter-${category.id}`}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="max-w-sm">
                <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
                <select
                  id="publisher-filter"
                  data-testid="publisher-filter"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>

              <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-result-count">
                Showing {games.length} games
              </p>
            </div>
          </section>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="hidden py-8 text-center text-slate-400" data-testid="no-filter-results">
            No games match the selected filters.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid^="category-filter-"]'));
  const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  const updateFilters = (): void => {
    const selectedCategories = categoryInputs.filter((input) => input.checked).map((input) => input.value);
    const selectedPublisher = publisherSelect?.value ?? '';
    let visibleCount = 0;

    for (const card of gameCards) {
      const categoryId = card.dataset.categoryId ?? '';
      const publisherId = card.dataset.publisherId ?? '';
      const categoryMatches = selectedCategories.length === 0 || selectedCategories.includes(categoryId);
      const publisherMatches = selectedPublisher === '' || publisherId === selectedPublisher;
      const visible = categoryMatches && publisherMatches;

      card.classList.toggle('hidden', !visible);
      visibleCount += visible ? 1 : 0;
    }

    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCount} games`;
    }
    emptyResults?.classList.toggle('hidden', visibleCount !== 0);
  };

  categoryInputs.forEach((input) => input.addEventListener('change', updateFilters));
  publisherSelect?.addEventListener('change', updateFilters);
</script>
